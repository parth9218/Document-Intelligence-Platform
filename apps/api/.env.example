# API Service Configuration

# Port to listen on
PORT=3000

# Node Environment (production, development, test)
NODE_ENV=development

# Database connection URL (PostgreSQL + pgvector schema)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/docintel?schema=public"

# Session HMAC signing secret (Use a secure, long string in production)
SESSION_SECRET="dev-session-secret-key-change-in-production-12345"

# AWS Configuration (Localstack settings provided as defaults)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=mock-key
AWS_SECRET_ACCESS_KEY=mock-secret

# AWS S3 Bucket name for original documents
S3_BUCKET=documents-bucket
LOCALSTACK_URL=http://localhost:4566
# Custom S3 endpoint URL (Set to http://localhost:4566 for local Localstack development)
# AWS_ENDPOINT_URL=http://localhost:4566

# CORS Configuration
# In production, set this to the allowed frontend origin (e.g. https://docintel.domain.com)
# In development/test, if unset, defaults to dynamically allowing the request origin
CORS_ALLOWED_ORIGIN=http://localhost:3001

# Embeddings provider settings
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=Xenova/e5-large-v2