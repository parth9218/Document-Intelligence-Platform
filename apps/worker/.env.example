# Postgres Database Configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/docintel
DB_IAM_AUTH_ENABLED=true
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_SSL=true
DB_SSL_ROOT_CERT=/app/global-bundle.pem

# AWS Configuration
AWS_REGION=us-east-1

# LocalStack Configuration (set empty in production environments)
LOCALSTACK_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=mock-key
AWS_SECRET_ACCESS_KEY=mock-secret

# AWS SQS Queue URLs
QUEUE_URL=http://localhost:4566/000000000000/document-ingestion-queue
DLQ_URL=http://localhost:4566/000000000000/document-ingestion-queue-dlq

# Environment
PYTHON_ENV=development

# AWS S3 Configuration
S3_BUCKET=documents-bucket

# Embedding Provider (local or bedrock)
EMBEDDING_PROVIDER=local

